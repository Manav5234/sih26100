# Copy to backend/.env for local development — app/config.py loads it
# automatically (path resolved from config.py, not the shell's cwd).
# Real environment variables always override these values.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih26100
# docker-compose / container hostname:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sih26100

# --- Auth -------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=changeme-generate-a-real-one-with-openssl-rand-hex-32
# docker-compose default:
# JWT_SECRET=sih26100-dev-secret-change-in-production

# --- CORS -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# --- Uploads ----------------------------------------------------------------
# Relative paths are resolved against backend/ (ignored by git).
# docker image default: /data/uploads
UPLOAD_ROOT=./uploads
# Longest image edge before an upload is downscaled (px)
MAX_IMAGE_DIMENSION=2000

# --- LLM (local Ollama, schema-strict JSON extraction) ----------------------
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4
# seconds before an LLM extraction call falls back to the template
LLM_TIMEOUT=300

# --- Legacy -----------------------------------------------------------------
# OCR_ENGINE_MODE=auto   # no longer read by the backend; app/ocr.py picks the
                         # engine automatically (PaddleOCR, else RapidOCR)
